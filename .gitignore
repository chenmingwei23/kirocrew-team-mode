# Install artifacts the gateway writes into an installed app directory.
# Committing data/ in particular causes stale-version display and leaks the
# resolved paths (and any stored credential) from one machine to another.
/build
/release-info
.app_secret
app-crons.json
installed.json
data/

node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
